# ─────────────────────────────────────────────────────────────────────────────
# AdPilot AI — environment variables
# Copy to .env.local for development. NEVER commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# Data mode: "demo" (generated SketchDeck data, no credentials) or "live".
DATA_MODE=demo
# Pin the demo dataset's last day (YYYY-MM-DD). Defaults to yesterday (UTC).
# DEMO_ANCHOR_DATE=2026-09-13
# Require sign-in even in demo mode (default: public demo).
# DEMO_REQUIRE_AUTH=false

# ── Database / auth (Supabase) — required in live mode, optional in demo ──────
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Organization the scheduled jobs operate on (uuid from the organizations table).
ADPILOT_ORGANIZATION_ID=

# ── NotFair MCP (primary live data source: Google Ads + GA4) ─────────────────
# Remote MCP server URL (Streamable HTTP) and bearer token issued by NotFair.
NOTFAIR_MCP_URL=
NOTFAIR_API_KEY=
# Optional: Google Ads account id inside NotFair (defaults to the primary account, 2175229247 for SketchDeck).
NOTFAIR_GOOGLE_ADS_ACCOUNT_ID=
# Optional: GA4 property (defaults to the active property, properties/454640302 for SketchDeck).
GA4_PROPERTY_ID=

# ── Google Ads direct API (optional; NotFair is the default path) ─────────────
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# ── Meta Marketing API ───────────────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# ── LinkedIn Marketing API ───────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AD_ACCOUNT_ID=

# ── HubSpot (private app token) ──────────────────────────────────────────────
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_ACCESS_TOKEN=

# ── Search Console (read through NotFair once connected there) ───────────────
GOOGLE_SEARCH_CONSOLE_SITE_URL=

# ── Email (daily brief). Provider: console | resend | sendgrid ───────────────
EMAIL_PROVIDER=console
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=AdPilot AI <adpilot@sketchdeck.ai>
DAILY_BRIEF_RECIPIENTS=

# ── Scheduled jobs ───────────────────────────────────────────────────────────
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET`; required in production.
CRON_SECRET=
