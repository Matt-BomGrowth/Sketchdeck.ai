# ─────────────────────────────────────────────────────────────────────────────
# AdPilot AI — environment variables
# Copy to .env.local for local development: `cp .env.example .env.local`.
# .env.local is git-ignored and blocked by the pre-commit hook and CI; NEVER put real values here.
# Next.js and every npm script (scan, brief, hubspot:verify, notfair:auth, db:*) read .env.local automatically.
# ─────────────────────────────────────────────────────────────────────────────

# Data mode: "demo" (generated SketchDeck data, no credentials) or "live".
DATA_MODE=demo
# Pin the demo dataset's last day (YYYY-MM-DD). Defaults to yesterday (UTC).
# DEMO_ANCHOR_DATE=2026-09-13
# Require sign-in even in demo mode (default: public demo).
# DEMO_REQUIRE_AUTH=false

# ── Database / auth (Supabase) — required in live mode, optional in demo ──────
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Organization the scheduled jobs operate on (uuid from the organizations table).
ADPILOT_ORGANIZATION_ID=

# ── NotFair MCP (primary live data source: Google Ads + GA4) ─────────────────
# Remote MCP server URL (Streamable HTTP). NotFair uses OAuth 2.1 + PKCE, not API keys.
# In production (Vercel): set this + ADPILOT_ORGANIZATION_ID + Supabase above, then click
# "Connect NotFair" on the deployed app's Integrations page — no terminal needed, tokens
# are stored server-side in the integration_secrets table. See docs/integrations/notfair.md.
NOTFAIR_MCP_URL=
# Local development only (needs a terminal + browser on the same machine):
# run `npm run notfair:auth` once and paste the two JSON values it prints here.
NOTFAIR_OAUTH_CLIENT=
NOTFAIR_OAUTH_TOKENS=
# Optional: store OAuth material in the integration_secrets table instead (service role required).
# NOTFAIR_TOKEN_STORE=supabase
# Optional: static bearer token, only if NotFair issues one.
NOTFAIR_API_KEY=
# Optional: Google Ads account id inside NotFair (defaults to the primary account, 2175229247 for SketchDeck).
NOTFAIR_GOOGLE_ADS_ACCOUNT_ID=
# Optional: GA4 property (defaults to the active property, properties/454640302 for SketchDeck).
GA4_PROPERTY_ID=

# ── Google Ads direct API (optional; NotFair is the default path) ─────────────
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# ── Meta Marketing API ───────────────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# ── LinkedIn Marketing API ───────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AD_ACCOUNT_ID=

# ── HubSpot (HubSpot Service Key created for AdPilot AI - SketchDeck) ───────
# Production: set in Vercel → Project → Settings → Environment Variables. Local: .env.local only.
# Must be SketchDeck's OWN portal (where hubspot_form_submit events land), not the agency portal.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_ACCESS_TOKEN=

# ── Search Console (read through NotFair once connected there) ───────────────
GOOGLE_SEARCH_CONSOLE_SITE_URL=

# ── Email (daily brief). Provider: console | resend | sendgrid ───────────────
EMAIL_PROVIDER=console
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=AdPilot AI <adpilot@sketchdeck.ai>
DAILY_BRIEF_RECIPIENTS=

# ── Scheduled jobs ───────────────────────────────────────────────────────────
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET`; required in production.
CRON_SECRET=
